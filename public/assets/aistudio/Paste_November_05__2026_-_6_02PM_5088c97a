  // ==================== مولّد الشبكات ====================
  function shuffleArray(arr) {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function generateHardGridData(size = 18) {
    const data = [];
    for (let r = 0; r < size; r++) {
      const row = [];
      for (let c = 0; c < size; c++) {
        row.push(Math.random() < 0.2 ? 0 : 1);
      }
      data.push(row);
    }
    let whiteCount = 0;
    for (let r = 0; r < size; r++)
      for (let c = 0; c < size; c++)
        if (data[r][c] === 1) whiteCount++;
    
    while (whiteCount < 250) {
      const r = Math.floor(Math.random() * size);
      const c = Math.floor(Math.random() * size);
      if (data[r][c] === 0) {
        data[r][c] = 1;
        whiteCount++;
      }
    }
    return data;
  }

  function generateHardClues(gridData, bank, count = 28) {
    const whiteCells = [];
    for (let r = 0; r < gridData.length; r++)
      for (let c = 0; c < gridData[r].length; c++)
        if (gridData[r][c] === 1) whiteCells.push({ r, c });

    const shuffledCells = shuffleArray(whiteCells);
    const shuffledClues = shuffleArray(bank);
    const clues = {};
    let placed = 0;
    let clueIndex = 0;

    for (let i = 0; i < shuffledCells.length && placed < count && clueIndex < shuffledClues.length; i++) {
      const { r, c } = shuffledCells[i];
      const clue = shuffledClues[clueIndex];
      const direction = placed % 2 === 0 ? 'h' : 'v';
      
      let canPlace = true;
      const len = clue.answer.length;
      
      if (direction === 'h') {
        for (let k = 0; k < len; k++) {
          if (c - k < 0 || gridData[r][c - k] !== 1) { canPlace = false; break; }
        }
        if (canPlace && !clues[`${r},${c}`]) {
          clues[`${r},${c}`] = { text: clue.text, dir: 'أفقي', answer: clue.answer, hint: clue.hint };
          placed++;
          clueIndex++;
        }
      } else {
        for (let k = 0; k < len; k++) {
          if (r + k >= gridData.length || gridData[r + k][c] !== 1) { canPlace = false; break; }
        }
        if (canPlace && !clues[`${r},${c}_v`]) {
          clues[`${r},${c}_v`] = { text: clue.text, dir: 'عمودي', answer: clue.answer, hint: clue.hint };
          placed++;
          clueIndex++;
        }
      }
    }
    return clues;
  }

  function createNewHardNetwork(bank) {
    const gridData = generateHardGridData(18);
    const clues = generateHardClues(gridData, bank, 28);
    return { gridData, clues };
  }

  // ==================== إدارة الأوضاع ====================
  let currentMode = 'moroccan'; // 'moroccan' أو 'science'
  let networks = [];
  let currentNetworkIndex = 0;
  let currentClueKey = null;
  let hardMode = true;
  let timerInterval = null;
  let seconds = 0;

  const gridElement = document.getElementById('grid');
  const cluePanel = document.getElementById('cluePanel');
  const clueText = document.getElementById('clueText');
  const clueHint = document.getElementById('clueHint');
  const counter = document.getElementById('counter');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const networkSelect = document.getElementById('networkSelect');
  const timerEl = document.getElementById('timer');
  const hardModeBtn = document.getElementById('hardModeBtn');
  const badgeText = document.getElementById('badgeText');

  function getActiveBank() {
    return currentMode === 'moroccan' ? moroccanCluesBank : scienceCluesBank;
  }

  function initNetworksForMode() {
    networks = [];
    for (let i = 0; i < 50; i++) {
      networks.push(createNewHardNetwork(getActiveBank()));
    }
    currentNetworkIndex = 0;
    currentClueKey = null;
    closePanel();
    gridElement.innerHTML = '';
    initGrid();
    updateNav();
    startTimer();
    badgeText.textContent = currentMode === 'moroccan' ? 'صعب مغربي' : 'صعب علمي';
    badgeText.className = 'difficulty-badge' + (currentMode === 'science' ? ' science-badge' : '');
  }

  function switchMode(mode) {
    if (currentMode === mode) return;
    currentMode = mode;
    
    // تحديث أزرار الوضع
    document.getElementById('modeMoroccan').classList.toggle('active', mode === 'moroccan');
    document.getElementById('modeScience').classList.toggle('active', mode === 'science');
    
    initNetworksForMode();
  }

  // ==================== المؤقت ====================
  function startTimer() {
    clearInterval(timerInterval);
    seconds = 0;
    timerEl.textContent = '00:00';
    timerEl.className = 'timer';
    timerInterval = setInterval(() => {
      seconds++;
      const mins = String(Math.floor(seconds / 60)).padStart(2, '0');
      const secs = String(seconds % 60).padStart(2, '0');
      timerEl.textContent = `${mins}:${secs}`;
      if (seconds >= 300) timerEl.className = 'timer danger';
      else if (seconds >= 180) timerEl.className = 'timer warning';
    }, 1000);
  }

  function stopTimer() {
    clearInterval(timerInterval);
  }

  function toggleHardMode() {
    hardMode = !hardMode;
    hardModeBtn.textContent = hardMode ? 'وضع صعب: مفعل' : 'وضع صعب: معطل';
    document.querySelectorAll('.arrow').forEach(arrow => {
      arrow.classList.toggle('hidden', hardMode);
    });
  }

  function updateNav() {
    counter.textContent = `الشبكة ${currentNetworkIndex + 1} من ${networks.length}`;
    prevBtn.disabled = currentNetworkIndex === 0;
    nextBtn.disabled = currentNetworkIndex === networks.length - 1;
    
    networkSelect.innerHTML = '';
    networks.forEach((_, i) => {
      const opt = document.createElement('option');
      opt.value = i;
      opt.textContent = `شبكة ${i + 1}`;
      if (i === currentNetworkIndex) opt.selected = true;
      networkSelect.appendChild(opt);
    });
  }

  function switchNetwork(index) {
    if (index < 0 || index >= networks.length) return;
    currentNetworkIndex = index;
    currentClueKey = null;
    closePanel();
    gridElement.innerHTML = '';
    initGrid();
    updateNav();
    startTimer();
  }

  function prevNetwork() { switchNetwork(currentNetworkIndex - 1); }
  function nextNetwork() { switchNetwork(currentNetworkIndex + 1); }

  function generateNewNetwork() {
    networks.push(createNewHardNetwork(getActiveBank()));
    switchNetwork(networks.length - 1);
  }

  function initGrid() {
    const data = networks[currentNetworkIndex];
    const { gridData } = data;
    
    gridElement.style.gridTemplateColumns = `repeat(${gridData[0].length}, 1fr)`;
    
    for (let r = 0; r < gridData.length; r++) {
      for (let c = 0; c < gridData[r].length; c++) {
        const cell = document.createElement('div');
        cell.className = 'cell';
        cell.dataset.row = r;
        cell.dataset.col = c;

        if (gridData[r][c] === 0) {
          cell.classList.add('black');
        } else {
          const input = document.createElement('input');
          input.type = 'text';
          input.maxLength = 1;
          
          input.addEventListener('input', (e) => {
            e.target.value = e.target.value.replace(/[^ء-ي0-9]/g, '');
            moveNext(); 
          });
          
          input.addEventListener('click', (e) => {
            e.stopPropagation();
            handleCellClick(r, c);
          });
          
          cell.appendChild(input);

          if (c === 0 || gridData[r][c-1] === 0) {
            const arrow = document.createElement('span');
            arrow.className = 'arrow arrow-left' + (hardMode ? ' hidden' : '');
            arrow.innerHTML = '◀';
            cell.appendChild(arrow);
          }
          if (r === 0 || gridData[r-1][c] === 0) {
            const arrow = document.createElement('span');
            arrow.className = 'arrow arrow-up' + (hardMode ? ' hidden' : '');
            arrow.innerHTML = '▲';
            cell.appendChild(arrow);
          }
        }
        cell.addEventListener('click', () => handleCellClick(r, c));
        gridElement.appendChild(cell);
      }
    }
  }

  function handleCellClick(r, c) {
    const data = networks[currentNetworkIndex];
    if (data.gridData[r][c] === 0) return;

    document.querySelectorAll('.cell.active').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.cell.correct').forEach(el => el.classList.remove('correct'));
    document.querySelectorAll('.cell.wrong').forEach(el => el.classList.remove('wrong'));
    
    const cell = document.querySelector(`.cell[data-row="${r}"][data-col="${c}"]`);
    if (cell) cell.classList.add('active');

    const keyH = `${r},${c}`;
    const keyV = `${r},${c}_v`;

    if (data.clues[keyH]) {
      currentClueKey = keyH;
      clueText.innerHTML = `<strong>[${data.clues[keyH].dir}]</strong> ${data.clues[keyH].text}`;
      clueHint.textContent = hardMode ? '' : `💡 ${data.clues[keyH].hint || ''}`;
      cluePanel.classList.add('active');
      cell.querySelector('input').focus();
    } else if (data.clues[keyV]) {
      currentClueKey = keyV;
      clueText.innerHTML = `<strong>[${data.clues[keyV].dir}]</strong> ${data.clues[keyV].text}`;
      clueHint.textContent = hardMode ? '' : `💡 ${data.clues[keyV].hint || ''}`;
      cluePanel.classList.add('active');
      cell.querySelector('input').focus();
    } else {
      clueText.innerHTML = "لا يوجد سؤال مسجل لهذه الخانة (اضغط على خانة أخرى).";
      clueHint.textContent = '';
      cluePanel.classList.add('active');
      cell.querySelector('input').focus();
    }
  }

  function moveNext() {
    if (!currentClueKey) return;
    const data = networks[currentNetworkIndex];
    const currentInput = document.activeElement;
    
    if (currentInput && currentInput.tagName === 'INPUT') {
      const row = parseInt(currentInput.parentElement.dataset.row);
      const col = parseInt(currentInput.parentElement.dataset.col);
      
      let nextRow = row;
      let nextCol = col;

      if (currentClueKey.includes('_v')) {
        nextRow++; 
      } else {
        nextCol--;
      }

      if (nextRow >= 0 && nextRow < data.gridData.length && nextCol >= 0 && nextCol < data.gridData[0].length && data.gridData[nextRow][nextCol] === 1) {
        const nextCell = document.querySelector(`.cell[data-row="${nextRow}"][data-col="${nextCol}"]`);
        if (nextCell) nextCell.querySelector('input').focus();
      }
    }
  }

  function checkAnswer() {
    if (!currentClueKey) return;
    const data = networks[currentNetworkIndex];
    const clue = data.clues[currentClueKey];
    const answer = clue.answer;
    
    let [startR, startC] = currentClueKey.replace('_v', '').split(',').map(Number);
    let isVertical = currentClueKey.includes('_v');
    
    let isValid = true;
    let inputs = [];

    for (let i = 0; i < answer.length; i++) {
      let r = startR + (isVertical ? i : 0);
      let c = startC + (!isVertical ? -i : 0);
      
      if (r >= data.gridData.length || c < 0) break;

      const cell = document.querySelector(`.cell[data-row="${r}"][data-col="${c}"]`);
      if (!cell) break;
      
      const input = cell.querySelector('input');
      if (!input) break;

      inputs.push(input);
      const val = input.value.trim();
      
      if (val !== answer[i]) {
        isValid = false;
      }
    }

    if (isValid) {
      inputs.forEach(input => input.parentElement.classList.add('correct'));
      alert("إجابة صحيحة! أحسنت 🌟");
    } else {
      inputs.forEach(input => {
        if (input.value.trim() !== '') {
          input.parentElement.classList.add('wrong');
        }
      });
      alert("إجابة خاطئة، حاول مرة أخرى 🤔");
    }
  }

  function showHint() {
    if (!currentClueKey) return;
    const data = networks[currentNetworkIndex];
    const clue = data.clues[currentClueKey];
    if (clue.hint) {
      clueHint.textContent = `💡 ${clue.hint}`;
    } else {
      clueHint.textContent = "لا يوجد تلميح متاح لهذا السؤال.";
    }
  }

  function closePanel() {
    cluePanel.classList.remove('active');
    document.querySelectorAll('.cell.active').forEach(el => el.classList.remove('active'));
    currentClueKey = null;
  }

  // ==================== البدء ====================
  initNetworksForMode();
</script>
